// Prisma schema for Activity Central
// Dev default is SQLite (file-based, zero setup). For production, point
// DATABASE_URL at a real Postgres instance (Vercel Postgres, Supabase, etc.)
// and change provider below to "postgresql".

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String    @id @default(cuid())
  name                 String?
  email                String    @unique
  passwordHash         String
  createdAt            DateTime  @default(now())

  // Stripe
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String    @default("inactive") // inactive | active | past_due | canceled
  subscriptionRenewsAt DateTime?

  downloads            Download[]
  calendarEvents       CalendarEvent[]
}

model CalendarEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  year      Int
  month     Int      // 0-11, matches the calendar page's month index
  day       Int
  title     String
  time      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, year, month])
}

model Download {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  templateId   String
  templateName String
  category     String
  downloadedAt DateTime @default(now())
}
model Template {
  id            String   @id @default(cuid())
  title         String
  category      String
  fileUrl       String
  fileName      String
  answerFileUrl String?
  largePrintFileUrl String?
  videoUrl      String?
  // Calendar occasion slug (lib/occasions.ts) for themed packs; null for
  // the regular category library.
  occasion      String?
  // Language slug (lib/languages.ts) for Communication Cards; null for
  // every other category.
  language      String?
  createdAt     DateTime @default(now())
}
