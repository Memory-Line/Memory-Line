// Prisma schema for Activity Central
// Dev default is SQLite (file-based, zero setup). For production, point
// DATABASE_URL at a real Postgres instance (Vercel Postgres, Supabase, etc.)
// and change provider below to "postgresql".

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String    @id @default(cuid())
  name                 String?   // the care home's name for care-home accounts
  accountType          String    @default("personal") // personal | care-home
  // Extra features switched on for this account by the admin (lib/features.ts).
  features             String[]  @default([])
  // Which pricing tier this account gets (lib/plans.ts). Defaults to
  // "premium" so nobody loses access when this field is introduced;
  // new sign-ups are set explicitly by Stripe checkout / the webhook.
  plan                 String    @default("premium") // standard | premium
  email                String    @unique
  passwordHash         String
  createdAt            DateTime  @default(now())

  // Stripe
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String    @default("inactive") // inactive | active | past_due | canceled | free (given by admin, no Stripe)
  subscriptionRenewsAt DateTime?
  // The subscription we've already sent a "you're on the X plan" email for,
  // so a repeated Stripe message can't send a second one.
  planEmailSentFor     String?

  downloads           Download[]
  calendarEvents       CalendarEvent[]
  completions          Completion[]
  passwordResets       PasswordResetToken[]
  sharedCalendars      SharedCalendar[]
  sharedFiles          SharedFile[]
  sharedFolders        SharedFolder[]
  calendarRotas        CalendarRota[]
  sharedForms          SharedForm[]
}

// An online questionnaire a home can put on its website. Set up by the admin for
// an account that has the "questionnaires" feature; the address the answers go to
// (notifyEmail) is also set only by the admin, so a form can never be pointed at
// a stranger's inbox. Answers are emailed and not stored (nothing is kept here).
model SharedForm {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String   @unique
  title       String
  intro       String   @default("")
  thanks      String   @default("")
  items       Json     // the sections and questions (see lib/forms.ts)
  notifyEmail String
  logoPath    String?  // the home's logo, a file under /public (shown on the PDFs)
  brandLines  String?  // address and contact details printed at the foot of the PDFs
  createdAt   DateTime @default(now())

  @@index([userId])
}

// A home's repeating 4-week rota for one of its calendars (Holidays &
// Celebrations or the professional one). It is a layer shown on the calendar,
// not saved date by date; see lib/rota.ts. One row per account and calendar.
model CalendarRota {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendar  String   @default("activity") // activity | professional
  enabled   Boolean  @default(false)      // older: the whole calendar; now just kept in step with months
  months    String[] @default([])         // the months the rota is on for, "YYYY-MM"
  mode      String   @default("preset")   // preset | custom
  startDate String                        // YYYY-MM-DD, the Monday Week 1 starts on
  slots     Json?                         // 4 weeks x 5 days of text, used when mode is custom
  updatedAt DateTime @updatedAt

  @@unique([userId, calendar])
}

// A named folder that groups a home's shared-file links on the Shared files page.
// Only for tidying: deleting a folder never deletes its links, they just become
// unfiled.
model SharedFolder {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  files     SharedFile[]
  createdAt DateTime     @default(now())

  @@index([userId])
}

// A public, read-only link to up to 10 files a care home has uploaded (a menu,
// newsletter, room pictures), shown on a page with our branding. The token in
// the address is the only key; deleting the row (and its files) switches the
// link off. Files can be replaced, added or removed and the link stays the same.
model SharedFile {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token         String   @unique
  title         String
  // Old single-file links kept their file here; it's moved into SharedFileItem
  // the first time the link is read (lib/sharedFilesDb.ts) and these are cleared.
  fileUrl       String?
  contentType   String?
  sizeBytes     Int?
  allowDownload Boolean  @default(false)
  folderId      String?
  folder        SharedFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  items         SharedFileItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

// One stored file (Vercel Blob) on a shared link. Its address is never shown to
// visitors; it's served through /api/f/[token]/file.
model SharedFileItem {
  id           String     @id @default(cuid())
  sharedFileId String
  sharedFile   SharedFile @relation(fields: [sharedFileId], references: [id], onDelete: Cascade)
  fileUrl      String
  contentType  String     // application/pdf | image/jpeg | image/png
  sizeBytes    Int
  position     Int
  // What the visitor sees on the link's menu (e.g. Menu, Calendar, Complaints form).
  name         String?
  createdAt    DateTime   @default(now())

  @@index([sharedFileId])
}

// A public, read-only link to some months of an account's calendar, so a care
// home can put it on its own website. Anyone with the link (the random token in
// its address) can see those months, including the events the account added;
// deleting the row switches the link off.
model SharedCalendar {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  calendar  String   @default("activity") // activity | professional
  year      Int
  months    Int[]    // 0-11
  createdAt DateTime @default(now())

  @@index([userId])
}

// One-time "forgot my password" links. Only a hash of the link's secret is
// stored (like a password), so a database leak can't be used to reset anyone.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// People who agreed to receive our promotional emails (updates, new activities,
// offers). Kept separate from User so someone can unsubscribe without touching
// their account, and so the list can grow beyond account holders later.
// Nobody goes on it without ticking the box, and consentAt records when.
model MailingContact {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  source         String    // where they joined: "signup", ...
  consentAt      DateTime  @default(now())
  unsubscribedAt DateTime? // set = never email them again
  // Random secret in the unsubscribe link in every email we send them.
  unsubscribeToken String  @unique
  createdAt      DateTime  @default(now())
}

model CalendarEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  year      Int
  month     Int      // 0-11, matches the calendar page's month index
  day       Int
  // "activity" = the Holidays & Celebrations calendar; "professional" = the
  // blank calendar (a per-account feature).
  calendar  String   @default("activity")
  title     String
  time      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, year, month])
}

model Download {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  templateId   String
  templateName String
  category     String
  downloadedAt DateTime @default(now())
}
model Template {
  id            String   @id @default(cuid())
  title         String
  category      String
  fileUrl       String
  fileName      String
  answerFileUrl String?
  largePrintFileUrl String?
  videoUrl      String?
  // Calendar occasion slug (lib/occasions.ts) for themed packs; null for
  // the regular category library.
  occasion      String?
  // Language slug (lib/languages.ts) for Communication Cards; null for
  // every other category.
  language      String?
  // Sub-category slug (lib/subcategories.ts), e.g. Sudoku level; null for
  // categories without sub-categories.
  subcategory   String?
  createdAt     DateTime @default(now())
  completions   Completion[]
}

// Activities an account has marked as completed (the "completion-tracking"
// feature). One row per account and activity; everyone using that login
// shares the list.
model Completion {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId  String
  template    Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, templateId])
}
